module

import GeneralLinearGroups.PrincipalUnits
import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic.NormNum

/-!
# Principal-unit ideal-layer clients

In `ZMod 27`, the ideals generated by `3` and `9` give a layer with nonzero
smaller ideal. The principal unit with value `4` corresponds to the nonzero
class of `3`. In `ℤ`, the same ideal generators satisfy the square containment,
but the original-ring principal-unit subgroup is trivial and the additive
layer is not. In contrast, `4` is a nontrivial unit in the kernel of reduction
from `ZMod 9` to `ZMod 3`.

-/

set_option linter.privateModule false

@[expose] public section

namespace Ideal

private def layerI : Ideal (ZMod 27) := Ideal.span {(3 : ZMod 27)}

private def layerJ : Ideal (ZMod 27) := Ideal.span {(9 : ZMod 27)}

private theorem layer_containments : layerJ ≤ layerI ∧ layerI ^ 2 ≤ layerJ := by
  constructor
  · rw [layerJ, layerI, Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton]
    exact ⟨3, by decide⟩
  · norm_num [layerI, layerJ, Ideal.span_singleton_pow]

private theorem layer_jacobson : layerI ≤ Ring.jacobson (ZMod 27) := by
  rw [layerI, Ideal.span_singleton_le_iff_mem, ← Ideal.jacobson_bot]
  apply Ideal.radical_le_jacobson
  exact ⟨3, by change (3 : ZMod 27) ^ 3 = 0; decide⟩

private theorem layerJ_ne_bot : layerJ ≠ ⊥ := by
  intro h
  have h9 : (9 : ZMod 27) ∈ layerJ := Ideal.subset_span (by simp)
  rw [h, Ideal.mem_bot] at h9
  exact (by decide : (9 : ZMod 27) ≠ 0) h9

private def layerThree : layerI := ⟨3, Ideal.subset_span (by simp)⟩

private noncomputable def layerFour : (MulAction.stabilizer (ZMod 27)ˣ
      (Submodule.Quotient.mk (1 : ZMod 27) : ZMod 27 ⧸ layerI)) :=
  layerI.principalUnitsMk layer_jacobson layerThree

private noncomputable def layerEquiv :
    (MulAction.stabilizer (ZMod 27)ˣ
      (Submodule.Quotient.mk (1 : ZMod 27) : ZMod 27 ⧸ layerI)) ⧸
        (layerI.principalUnitsToQuotient layerJ layer_containments.2).ker ≃*
      Multiplicative (layerI ⧸ Submodule.comap layerI.subtype layerJ) :=
  layerI.principalUnitsQuotientEquiv layerJ layer_containments.2 layer_jacobson

private theorem layerFour_value : (layerFour.1 : ZMod 27) = 4 := by
  simpa only [layerFour, principalUnitsMk_coe, layerThree] using
    (show (1 + (3 : ZMod 27)) = 4 by norm_num)

private theorem layerFour_inv_value : ((layerFour.1)⁻¹ : (ZMod 27)ˣ).val = 7 := by
  calc
    ((layerFour.1)⁻¹ : (ZMod 27)ˣ).val =
        ((layerFour.1)⁻¹ : (ZMod 27)ˣ).val * (4 * 7) := by
          rw [show (4 * 7 : ZMod 27) = 1 by decide, mul_one]
    _ = 7 := by rw [← layerFour_value, ← mul_assoc, Units.inv_mul, one_mul]

private theorem layerFour_coordinate :
    layerEquiv (QuotientGroup.mk layerFour) =
      Multiplicative.ofAdd (Submodule.Quotient.mk layerThree) := by
  exact layerI.principalUnitsToQuotient_mk layerJ layer_containments.2
    layer_jacobson layerThree

private theorem layerThree_class_ne_zero :
    (Submodule.Quotient.mk layerThree :
      layerI ⧸ Submodule.comap layerI.subtype layerJ) ≠ 0 := by
  rw [ne_eq, Submodule.Quotient.mk_eq_zero]
  change (3 : ZMod 27) ∉ layerJ
  rw [layerJ, Ideal.mem_span_singleton']
  rintro ⟨a, ha⟩
  have h := congrArg (ZMod.castHom (by norm_num : 9 ∣ 27) (ZMod 9)) ha
  simp only [map_mul, map_ofNat] at h
  rw [show (9 : ZMod 9) = 0 by decide, mul_zero] at h
  exact (by decide : (0 : ZMod 9) ≠ 3) h

private theorem layerFour_class_ne_one :
    (QuotientGroup.mk layerFour : (MulAction.stabilizer (ZMod 27)ˣ
      (Submodule.Quotient.mk (1 : ZMod 27) : ZMod 27 ⧸ layerI)) ⧸
      (layerI.principalUnitsToQuotient layerJ layer_containments.2).ker) ≠ 1 := by
  intro h
  have hc := congrArg layerEquiv h
  rw [layerFour_coordinate, map_one] at hc
  exact layerThree_class_ne_zero (ofAdd_eq_one.mp hc)

private def integerI : Ideal ℤ := Ideal.span {(3 : ℤ)}

private def integerJ : Ideal ℤ := Ideal.span {(9 : ℤ)}

private def integerThree : integerI := ⟨3, Ideal.subset_span (by simp)⟩

private theorem integer_containments : integerJ ≤ integerI ∧ integerI ^ 2 ≤ integerJ := by
  constructor
  · rw [integerJ, integerI, Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton]
    norm_num
  · norm_num [integerI, integerJ, Ideal.span_singleton_pow]

private theorem integer_jacobson_boundary :
    ¬ integerI ≤ Ring.jacobson ℤ := by
  intro h
  have hu := (integerI.principalUnitsMk h integerThree).1.isUnit
  rw [principalUnitsMk_coe] at hu
  norm_num [integerThree, Int.isUnit_iff] at hu

private theorem integer_principalUnits_eq_bot :
    MulAction.stabilizer ℤˣ (Submodule.Quotient.mk (1 : ℤ) : ℤ ⧸ integerI) = ⊥ := by
  rw [Subgroup.eq_bot_iff_forall]
  intro u hu
  rcases Int.units_eq_one_or u with h | h
  · exact h
  · rw [mem_stabilizer_quotient_one, h] at hu
    norm_num [integerI, Ideal.mem_span_singleton] at hu

private theorem integer_four_not_isUnit : ¬ IsUnit (1 + (3 : ℤ)) := by
  norm_num [Int.isUnit_iff]

private theorem integerThree_class_ne_zero :
    (Submodule.Quotient.mk integerThree :
      integerI ⧸ Submodule.comap integerI.subtype integerJ) ≠ 0 := by
  rw [ne_eq, Submodule.Quotient.mk_eq_zero]
  change (3 : ℤ) ∉ integerJ
  norm_num [integerJ, Ideal.mem_span_singleton]

private def fourModNine : (ZMod 9)ˣ where
  val := 4
  inv := 7
  val_inv := by decide
  inv_val := by decide

private theorem quotientRing_kernel_boundary :
    Units.map (ZMod.castHom (by norm_num : 3 ∣ 9) (ZMod 3)).toMonoidHom fourModNine = 1 ∧
      fourModNine ≠ 1 := by
  constructor
  · apply Units.ext
    decide
  · intro h
    have hv : (4 : ZMod 9) = 1 := congrArg Units.val h
    exact (by decide : (4 : ZMod 9) ≠ 1) hv

end Ideal
