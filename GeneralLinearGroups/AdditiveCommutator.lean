module

public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Algebra.Ring.Defs
public import Mathlib.Algebra.Ring.Equiv
public import Mathlib.GroupTheory.QuotientGroup.Defs

/-!
# Additive commutators and opposite quotients

The additive subgroup generated by differences `a * b - b * a` requires only
an additive group and multiplication. In a ring it need not be an ideal, so
its quotient is used only as an additive group.

For an additive commutative group with multiplication, the opposite equivalence
on additive-commutator quotients is induced by Mathlib's
`MulOpposite.opAddEquiv` using `QuotientAddGroup.congr`. Double application is
compared with Mathlib's `RingEquiv.opOp`, not with an identity across carriers.
-/

set_option warningAsError true

@[expose] public section

namespace Ring

universe u

section AddGroup

variable (R : Type u) [AddGroup R] [Mul R]

/-- The additive subgroup generated by all multiplicative commutators. -/
def additiveCommutators : AddSubgroup R :=
  AddSubgroup.closure {x : R | ∃ a b : R, x = a * b - b * a}

variable {R}

/-- Each difference `a * b - b * a` belongs to the additive commutator subgroup. -/
theorem commutator_mem_additiveCommutators (a b : R) :
    a * b - b * a ∈ additiveCommutators R :=
  AddSubgroup.subset_closure ⟨a, b, rfl⟩

variable (R)

/-- The additive opposite equivalence maps the commutator subgroup onto that
of the opposite multiplication. -/
theorem additiveCommutators_map_op :
    (additiveCommutators R).map
      (MulOpposite.opAddEquiv : R ≃+ Rᵐᵒᵖ).toAddMonoidHom =
    additiveCommutators Rᵐᵒᵖ := by
  unfold additiveCommutators
  rw [AddMonoidHom.map_closure]
  congr 1
  ext x
  constructor
  · rintro ⟨y, ⟨a, b, rfl⟩, rfl⟩
    exact ⟨MulOpposite.op b, MulOpposite.op a, rfl⟩
  · rintro ⟨a, b, rfl⟩
    exact ⟨MulOpposite.unop b * MulOpposite.unop a -
      MulOpposite.unop a * MulOpposite.unop b,
      ⟨MulOpposite.unop b, MulOpposite.unop a, rfl⟩, rfl⟩

/-- The canonical double-opposite equivalence preserves additive commutators. -/
theorem additiveCommutators_map_opOp :
    (additiveCommutators R).map
      (RingEquiv.opOp R).toAddEquiv.toAddMonoidHom =
    additiveCommutators Rᵐᵒᵖᵐᵒᵖ := by
  change (additiveCommutators R).map
    (((MulOpposite.opAddEquiv : Rᵐᵒᵖ ≃+ Rᵐᵒᵖᵐᵒᵖ).toAddMonoidHom).comp
      (MulOpposite.opAddEquiv : R ≃+ Rᵐᵒᵖ).toAddMonoidHom) = _
  rw [← AddSubgroup.map_map, additiveCommutators_map_op, additiveCommutators_map_op]

end AddGroup

section AddCommGroup

variable (R : Type u) [AddCommGroup R] [Mul R]

/-- The canonical additive equivalence between the commutator quotients of
an additive commutative group with multiplication and its opposite. -/
def additiveCommutatorQuotientOpEquiv :
    (R ⧸ additiveCommutators R) ≃+
      (Rᵐᵒᵖ ⧸ additiveCommutators Rᵐᵒᵖ) :=
  QuotientAddGroup.congr
    (additiveCommutators R) (additiveCommutators Rᵐᵒᵖ)
    (MulOpposite.opAddEquiv : R ≃+ Rᵐᵒᵖ) (additiveCommutators_map_op R)

/-- The opposite quotient equivalence sends a representative to its opposite. -/
@[simp] theorem additiveCommutatorQuotientOpEquiv_mk (r : R) :
    additiveCommutatorQuotientOpEquiv R (QuotientAddGroup.mk r) =
      QuotientAddGroup.mk (MulOpposite.op r) :=
  rfl

/-- The inverse opposite quotient equivalence unops a representative. -/
@[simp] theorem additiveCommutatorQuotientOpEquiv_symm_mk (r : Rᵐᵒᵖ) :
    (additiveCommutatorQuotientOpEquiv R).symm (QuotientAddGroup.mk r) =
      QuotientAddGroup.mk (MulOpposite.unop r) :=
  rfl

/-- Applying the opposite quotient equivalence twice agrees with transport
along the canonical double-opposite equivalence. -/
theorem additiveCommutatorQuotientOpEquiv_trans_op :
    (additiveCommutatorQuotientOpEquiv R).trans
        (additiveCommutatorQuotientOpEquiv Rᵐᵒᵖ) =
      QuotientAddGroup.congr
        (additiveCommutators R) (additiveCommutators Rᵐᵒᵖᵐᵒᵖ)
        (RingEquiv.opOp R).toAddEquiv (additiveCommutators_map_opOp R) := by
  apply AddEquiv.ext
  intro x
  refine QuotientAddGroup.induction_on x ?_
  intro r
  rfl

end AddCommGroup

end Ring
