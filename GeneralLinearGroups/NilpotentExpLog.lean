/-!
# Exponential units and logarithms of nilpotent coordinates

`IsNilpotent.expUnit` packages Mathlib's `IsNilpotent.exp` as a unit, using
`IsNilpotent.isUnit_exp`. Its underlying ring value is the existing exponential,
so Mathlib's finite-sum, commuting-addition and naturality formulas apply directly.
This unit API only requires a ring with a rational module structure.

For a unital rational algebra, logarithm takes a unit whose difference from one
is nilpotent to a ring element. Exponential and logarithm give a plain equivalence
of the corresponding subtypes. Multiplicative and additive formulas require
commuting inputs; no additive or group structure is imposed on these subtypes.

## Implementation notes

Logarithm evaluates Mathlib's rational formal logarithm by algebraic substitution
into constant series over the commutative subalgebra generated by one element.
The same evaluation agrees with Mathlib's nilpotent exponential. No topology or
global commutativity is required. Finite-sum formulas allow every nilpotence bound,
including zero in the zero algebra.

## References

This construction reuses Mathlib's formalization in `Mathlib.RingTheory.Nilpotent.Exp`,
especially `IsNilpotent.exp` and `IsNilpotent.isUnit_exp`, and its formal-series
`PowerSeries.exp`, `PowerSeries.log`, `PowerSeries.substAlgHom`, and
`MvPowerSeries.isEmptyEquiv`.
-/

@[expose] public section

universe u v

variable {R : Type u} [Ring R]
variable {S : Type v} [Ring S]

namespace IsNilpotent

section ExpUnit

variable [Module ℚ R] [Module ℚ S]

/-- Mathlib's exponential of a nilpotent element, packaged as a unit. -/
noncomputable def expUnit {x : R} (hx : IsNilpotent x) : Rˣ :=
  hx.isUnit_exp.unit

/-- The ring value of the exponential unit is Mathlib's nilpotent exponential. -/
@[simp] theorem coe_expUnit {x : R} (hx : IsNilpotent x) :
    (hx.expUnit : R) = exp x :=
  hx.isUnit_exp.unit_spec

/-- The exponential unit at zero is one, also in the zero ring. -/
@[simp] theorem expUnit_zero :
    (IsNilpotent.zero : IsNilpotent (0 : R)).expUnit = 1 := by
  apply Units.ext
  simp only [coe_expUnit, exp_zero, Units.val_one]

/-- Negation corresponds to inversion of the exponential unit. -/
@[simp] theorem expUnit_neg {x : R} (hx : IsNilpotent x) :
    hx.neg.expUnit = hx.expUnit⁻¹ := by
  apply eq_inv_of_mul_eq_one_right
  apply Units.ext
  simpa only [Units.val_mul, Units.val_one, coe_expUnit] using exp_mul_exp_neg_self hx

/-- The exponential unit takes a commuting sum to the ordered product. -/
theorem expUnit_add_of_commute {x y : R} (hx : IsNilpotent x) (hy : IsNilpotent y)
    (hxy : Commute x y) :
    (hxy.isNilpotent_add hx hy).expUnit = hx.expUnit * hy.expUnit := by
  apply Units.ext
  simpa only [Units.val_mul, coe_expUnit] using exp_add_of_commute hxy hx hy

/-- Integer multiples correspond to integer powers in the unit group. -/
theorem expUnit_zsmul {x : R} (hx : IsNilpotent x) (n : ℤ) :
    (hx.smul n).expUnit = hx.expUnit ^ n := by
  have hnat (m : ℕ) : (hx.smul m).expUnit = hx.expUnit ^ m := by
    induction m with
    | zero => simp
    | succ m ih =>
      have hcomm : Commute (m • x) x := (Commute.refl x).smul_left m
      calc
        (hx.smul (m + 1)).expUnit = (hx.smul m).expUnit * hx.expUnit := by
          simpa only [succ_nsmul] using expUnit_add_of_commute (hx.smul m) hx hcomm
        _ = hx.expUnit ^ (m + 1) := by rw [ih, _root_.pow_succ]
  cases n with
  | ofNat m =>
    change (hx.smul (m : ℤ)).expUnit = hx.expUnit ^ (m : ℤ)
    simpa only [natCast_zsmul, _root_.zpow_natCast] using hnat m
  | negSucc m =>
    simpa only [negSucc_zsmul, zpow_negSucc] using
      (expUnit_neg (hx.smul (m + 1))).trans (congrArg Inv.inv (hnat (m + 1)))

/-- Ring homomorphisms preserve exponential units. -/
theorem map_expUnit {F : Type*} [FunLike F R S] [RingHomClass F R S]
    {x : R} (hx : IsNilpotent x) (f : F) :
    Units.map (f : R →+* S).toMonoidHom hx.expUnit = (hx.map f).expUnit := by
  apply Units.ext
  simpa using hx.map_exp (f : R →+* S)

end ExpUnit

/-- Conjugation by a unit preserves nilpotence. -/
theorem units_conj {x : R} (hx : IsNilpotent x) (a : Rˣ) :
    IsNilpotent ((a : R) * x * (↑a⁻¹ : R)) := by
  obtain ⟨n, hn⟩ := hx
  refine ⟨n, ?_⟩
  rw [Units.conj_pow, hn, mul_zero, zero_mul]

/-- Exponential units commute with conjugation by arbitrary units. -/
theorem expUnit_conj [Module ℚ R] {x : R} (hx : IsNilpotent x) (a : Rˣ) :
    (hx.units_conj a).expUnit = a * hx.expUnit * a⁻¹ := by
  apply Units.ext
  simp only [coe_expUnit, Units.val_mul]
  obtain ⟨n, hn⟩ := hx
  have hconj : ((a : R) * x * (↑a⁻¹ : R)) ^ n = 0 := by
    rw [Units.conj_pow, hn, mul_zero, zero_mul]
  rw [exp_eq_sum hconj, exp_eq_sum hn, Finset.mul_sum, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro i _
  simp only [Units.conj_pow, mul_smul_comm, smul_mul_assoc]

end IsNilpotent

variable [ratR : Algebra ℚ R] [Algebra ℚ S]

open scoped IsMulCommutative

private theorem nilpotentEval_polynomial (x : {x : R // IsNilpotent x})
    (φ : PowerSeries ℚ →ₐ[ℚ] R) (hφ : φ PowerSeries.X = x.val)
    (p : Polynomial ℚ) : φ (p : PowerSeries ℚ) = Polynomial.aeval x.val p := by
  have h : φ.comp (Polynomial.coeToPowerSeries.algHom ℚ) = Polynomial.aeval x.val := by
    apply Polynomial.algHom_ext
    simpa using hφ
  simpa using AlgHom.congr_fun h p

private theorem nilpotentEval_eq_aeval_trunc (x : {x : R // IsNilpotent x})
    (φ : PowerSeries ℚ →ₐ[ℚ] R) (hφ : φ PowerSeries.X = x.val)
    (N : ℕ) (hN : x.val ^ N = 0) (f : PowerSeries ℚ) :
    φ f = Polynomial.aeval x.val (PowerSeries.trunc N f) := by
  calc
    φ f = φ (PowerSeries.X ^ N *
        PowerSeries.mk (fun i ↦ PowerSeries.coeff (i + N) f) +
        (PowerSeries.trunc N f : PowerSeries ℚ)) :=
      congrArg φ (PowerSeries.eq_X_pow_mul_shift_add_trunc N f)
    _ = φ (PowerSeries.trunc N f : PowerSeries ℚ) := by
      simp only [map_add, map_mul, map_pow, hφ, hN, zero_mul, zero_add]
    _ = _ := nilpotentEval_polynomial x φ hφ _

private theorem nilpotentEval_unique (x : {x : R // IsNilpotent x})
    (φ ψ : PowerSeries ℚ →ₐ[ℚ] R)
    (hφ : φ PowerSeries.X = x.val) (hψ : ψ PowerSeries.X = x.val) :
    φ = ψ := by
  obtain ⟨N, hN⟩ := x.property
  ext f
  exact (nilpotentEval_eq_aeval_trunc x φ hφ N hN f).trans
    (nilpotentEval_eq_aeval_trunc x ψ hψ N hN f).symm

private theorem nilpotentEval_exp (x : {x : R // IsNilpotent x})
    (φ : PowerSeries ℚ →ₐ[ℚ] R) (hφ : φ PowerSeries.X = x.val) :
    φ (PowerSeries.exp ℚ) = IsNilpotent.exp x.val := by
  obtain ⟨N, hN⟩ := x.property
  rw [nilpotentEval_eq_aeval_trunc x φ hφ N hN, Polynomial.aeval_def,
    PowerSeries.eval₂_trunc_eq_sum_range, IsNilpotent.exp_eq_sum hN]
  apply Finset.sum_congr rfl
  intro n hn
  simp [PowerSeries.coeff_exp, Algebra.smul_def]

namespace Units

/-- The logarithm of a unit whose difference from one is nilpotent. -/
noncomputable def log (u : {u : Rˣ // IsNilpotent ((u : R) - 1)}) : R := by
  let eval (x : {x : R // IsNilpotent x}) : PowerSeries ℚ →ₐ[ℚ] R := by
    let B : Subalgebra ℚ R := Algebra.adjoin ℚ ({x.val} : Set R)
    let xB : B := ⟨x.val, Algebra.self_mem_adjoin_singleton ℚ x.val⟩
    have hxB : IsNilpotent xB := by
      obtain ⟨n, hn⟩ := x.property
      refine ⟨n, Subtype.ext ?_⟩
      simpa only [Subalgebra.coe_pow, Subalgebra.coe_zero] using hn
    let a : MvPowerSeries PEmpty.{1} B := MvPowerSeries.C xB
    have ha : PowerSeries.HasSubst a := by
      simpa only [PowerSeries.HasSubst, a, MvPowerSeries.constantCoeff_C] using hxB
    exact B.val.comp
      ((((MvPowerSeries.isEmptyEquiv PEmpty.{1} B).restrictScalars ℚ).toAlgHom).comp
        (PowerSeries.substAlgHom (R := ℚ) ha))
  exact eval ⟨(u.val : R) - 1, u.property⟩ (PowerSeries.log ℚ)

private theorem log_eval_spec (u : {u : Rˣ // IsNilpotent ((u : R) - 1)}) :
    ∃ φ : PowerSeries ℚ →ₐ[ℚ] R,
      φ PowerSeries.X = (u.val : R) - 1 ∧ log u = φ (PowerSeries.log ℚ) := by
  unfold log
  refine ⟨_, ?_, rfl⟩
  simp [PowerSeries.substAlgHom_X, MvPowerSeries.isEmptyEquiv]

private theorem log_eq_eval (u : {u : Rˣ // IsNilpotent ((u : R) - 1)})
    (φ : PowerSeries ℚ →ₐ[ℚ] R) (hφ : φ PowerSeries.X = (u.val : R) - 1) :
    log u = φ (PowerSeries.log ℚ) := by
  obtain ⟨ψ, hψ, hlog⟩ := log_eval_spec u
  rw [hlog, nilpotentEval_unique ⟨(u.val : R) - 1, u.property⟩ ψ φ hψ hφ]

private theorem log_eq_aeval_trunc (u : {u : Rˣ // IsNilpotent ((u : R) - 1)})
    (N : ℕ) (hN : ((u.val : R) - 1) ^ N = 0) :
    log u = Polynomial.aeval ((u.val : R) - 1) (PowerSeries.trunc N (PowerSeries.log ℚ)) := by
  obtain ⟨φ, hφ, hlog⟩ := log_eval_spec u
  exact hlog.trans (nilpotentEval_eq_aeval_trunc ⟨(u.val : R) - 1, u.property⟩ φ hφ N hN _)

/-- Any nilpotence bound gives the same finite logarithm polynomial. -/
theorem log_eq_sum (u : {u : Rˣ // IsNilpotent ((u : R) - 1)})
    (N : ℕ) (hN : ((u.val : R) - 1) ^ N = 0) :
    log u = ∑ n ∈ Finset.Ico 1 N,
      (((-1 : ℚ) ^ (n + 1)) / (n : ℚ)) • ((u.val : R) - 1) ^ n := by
  rw [log_eq_aeval_trunc u N hN, Polynomial.aeval_def,
    PowerSeries.eval₂_trunc_eq_sum_range]
  have hcoeff (n : ℕ) : PowerSeries.coeff n (PowerSeries.log ℚ) =
      ((-1 : ℚ) ^ (n + 1)) / (n : ℚ) := by
    by_cases hn : n = 0 <;> simp [PowerSeries.coeff_log, hn]
  simp_rw [hcoeff, ← Algebra.smul_def]
  symm
  apply Finset.sum_subset
  · intro n hn
    exact Finset.mem_range.mpr (Finset.mem_Ico.mp hn).2
  · intro n hn hn'
    have hn0 : n = 0 := by
      by_contra h
      exact hn' (Finset.mem_Ico.mpr
        ⟨Nat.one_le_iff_ne_zero.mpr h, Finset.mem_range.mp hn⟩)
    subst n
    simp

/-- The logarithm polynomial is independent of the nilpotence bound. -/
theorem log_sum_eq_sum (u : {u : Rˣ // IsNilpotent ((u : R) - 1)}) (M N : ℕ)
    (hM : ((u.val : R) - 1) ^ M = 0) (hN : ((u.val : R) - 1) ^ N = 0) :
    (∑ n ∈ Finset.Ico 1 M,
      (((-1 : ℚ) ^ (n + 1)) / (n : ℚ)) • ((u.val : R) - 1) ^ n) =
      ∑ n ∈ Finset.Ico 1 N,
        (((-1 : ℚ) ^ (n + 1)) / (n : ℚ)) • ((u.val : R) - 1) ^ n :=
  (log_eq_sum u M hM).symm.trans (log_eq_sum u N hN)

/-- The logarithm has nilpotent value. -/
theorem isNilpotent_log (u : {u : Rˣ // IsNilpotent ((u : R) - 1)}) :
    IsNilpotent (log u) := by
  obtain ⟨φ, hφ, _⟩ := log_eval_spec u
  obtain ⟨g, hg⟩ : (PowerSeries.X : PowerSeries ℚ) ∣ PowerSeries.log ℚ :=
    PowerSeries.X_dvd_iff.mpr (by simp)
  rw [log_eq_eval u φ hφ, hg, map_mul]
  have hnil : IsNilpotent (φ PowerSeries.X) := by
    rw [hφ]
    exact u.property
  exact ((Commute.all (PowerSeries.X : PowerSeries ℚ) g).map φ).isNilpotent_mul_right hnil

/-- The logarithm of one is zero. -/
@[simp] theorem log_one :
    log (⟨1, by simp⟩ :
      {u : Rˣ // IsNilpotent ((u : R) - 1)}) = 0 := by
  rw [log_eq_sum _ 1 (by simp)]
  simp

end Units

private theorem nilpotentEval_exists (x : {x : R // IsNilpotent x}) :
    ∃ φ : PowerSeries ℚ →ₐ[ℚ] R, φ PowerSeries.X = x.val := by
  let u : Rˣ := x.property.isUnit_one_add.unit
  have hu : (u : R) - 1 = x.val := by
    rw [show (u : R) = 1 + x.val from x.property.isUnit_one_add.unit_spec]
    simp
  have hnil : IsNilpotent ((u : R) - 1) := hu.symm ▸ x.property
  obtain ⟨φ, hφ, _⟩ := Units.log_eval_spec ⟨u, hnil⟩
  exact ⟨φ, hφ.trans hu⟩

namespace IsNilpotent

/-- Logarithm is a left inverse of the exponential unit. -/
@[simp] theorem log_expUnit {x : R} (hx : IsNilpotent x) :
    Units.log ⟨hx.expUnit, by simpa using hx.isNilpotent_exp_sub_one⟩ = x := by
  obtain ⟨φ, hφ⟩ := nilpotentEval_exists ⟨x, hx⟩
  let ψ : PowerSeries ℚ →ₐ[ℚ] R :=
    φ.comp (PowerSeries.substAlgHom (PowerSeries.HasSubst.exp_sub_one (A := ℚ)))
  have hψ : ψ PowerSeries.X = (hx.expUnit : R) - 1 := by
    dsimp only [ψ, AlgHom.comp_apply]
    rw [PowerSeries.substAlgHom_X, map_sub, map_one,
      nilpotentEval_exp ⟨x, hx⟩ φ hφ, coe_expUnit]
  rw [Units.log_eq_eval _ ψ hψ]
  dsimp only [ψ, AlgHom.comp_apply]
  rw [PowerSeries.coe_substAlgHom, PowerSeries.subst_log_exp_sub_one]
  exact hφ

/-- The exponential unit is a left inverse of logarithm on units with nilpotent coordinate. -/
@[simp] theorem expUnit_log (u : {u : Rˣ // IsNilpotent ((u : R) - 1)}) :
    (Units.isNilpotent_log u).expUnit = u.val := by
  apply Units.ext
  rw [coe_expUnit]
  obtain ⟨φ, hφ⟩ := nilpotentEval_exists ⟨(u.val : R) - 1, u.property⟩
  let ψ : PowerSeries ℚ →ₐ[ℚ] R :=
    φ.comp (PowerSeries.substAlgHom (PowerSeries.HasSubst.log (A := ℚ)))
  have hψ : ψ PowerSeries.X = Units.log u := by
    dsimp only [ψ, AlgHom.comp_apply]
    rw [PowerSeries.substAlgHom_X]
    exact (Units.log_eq_eval u φ hφ).symm
  rw [← nilpotentEval_exp ⟨Units.log u, Units.isNilpotent_log u⟩ ψ hψ]
  dsimp only [ψ, AlgHom.comp_apply]
  rw [PowerSeries.coe_substAlgHom, PowerSeries.subst_exp_log, map_add, map_one, hφ]
  simpa only [add_comm] using sub_add_cancel (u.val : R) 1

/-- Exponentiating a logarithm recovers the underlying ring value of the unit. -/
@[simp] theorem exp_log (u : {u : Rˣ // IsNilpotent ((u : R) - 1)}) :
    exp (Units.log u) = (u.val : R) := by
  simpa only [coe_expUnit] using
    congrArg (fun v : Rˣ => (v : R)) (expUnit_log u)

end IsNilpotent

namespace IsNilpotent

/-- Nilpotent elements and units with nilpotent coordinate at one are equivalent as types. -/
noncomputable def expLogEquiv :
    {x : R // IsNilpotent x} ≃ {u : Rˣ // IsNilpotent ((u : R) - 1)} where
  toFun x := ⟨x.property.expUnit, by simpa using x.property.isNilpotent_exp_sub_one⟩
  invFun u := ⟨Units.log u, Units.isNilpotent_log u⟩
  left_inv x := Subtype.ext (log_expUnit x.property)
  right_inv u := Subtype.ext (expUnit_log u)

/-- The forward map of the equivalence is the exponential unit. -/
@[simp] theorem expLogEquiv_apply_coe (x : {x : R // IsNilpotent x}) :
    (expLogEquiv x).val = x.property.expUnit := rfl

/-- The inverse map of the equivalence is the logarithm ring element. -/
@[simp] theorem expLogEquiv_symm_apply_coe
    (u : {u : Rˣ // IsNilpotent ((u : R) - 1)}) :
    (expLogEquiv.symm u).val = Units.log u := rfl

/-- Equality of exponential units is equality of their ring coordinates. -/
@[simp] theorem expUnit_eq_expUnit_iff {x y : R} (hx : IsNilpotent x)
    (hy : IsNilpotent y) : hx.expUnit = hy.expUnit ↔ x = y := by
  constructor
  · intro h
    have h' : expLogEquiv ⟨x, hx⟩ = expLogEquiv ⟨y, hy⟩ := Subtype.ext h
    exact congrArg Subtype.val (expLogEquiv.injective h')
  · rintro rfl
    rfl

/-- An exponential unit is one exactly at the zero nilpotent coordinate. -/
@[simp] theorem expUnit_eq_one_iff {x : R} (hx : IsNilpotent x) :
    hx.expUnit = 1 ↔ x = 0 := by
  simpa only [expUnit_zero] using
    (expUnit_eq_expUnit_iff hx (IsNilpotent.zero : IsNilpotent (0 : R)))

end IsNilpotent

namespace Units

/-- Equality of logarithms detects equality of units with nilpotent coordinate. -/
theorem log_injective : Function.Injective (log (R := R)) := by
  intro u v h
  have h' : IsNilpotent.expLogEquiv.symm u = IsNilpotent.expLogEquiv.symm v :=
    Subtype.ext h
  exact IsNilpotent.expLogEquiv.symm.injective h'

/-- Equality of logarithms is equality of the underlying units. -/
@[simp] theorem log_eq_log_iff (u v : {u : Rˣ // IsNilpotent ((u : R) - 1)}) :
    log u = log v ↔ u.val = v.val := by
  constructor
  · intro h
    exact congrArg Subtype.val (log_injective h)
  · intro h
    exact congrArg log (Subtype.ext h)

/-- A logarithm vanishes exactly at the identity unit. -/
@[simp] theorem log_eq_zero_iff (u : {u : Rˣ // IsNilpotent ((u : R) - 1)}) :
    log u = 0 ↔ u.val = 1 := by
  simpa only [log_one] using
    (log_eq_log_iff u ⟨1, by simp⟩)

end Units

namespace Units

omit ratR in
/-- Inversion preserves the nilpotence of the coordinate at one. -/
theorem isNilpotent_inv_sub_one (u : {u : Rˣ // IsNilpotent ((u : R) - 1)}) :
    IsNilpotent (((u.val⁻¹ : Rˣ) : R) - 1) := by
  have hcomm : Commute (↑u.val⁻¹ : R) ((u.val : R) - 1) := by
    change (↑u.val⁻¹ : R) * ((u.val : R) - 1) =
      ((u.val : R) - 1) * (↑u.val⁻¹ : R)
    simp only [mul_sub, sub_mul, mul_one, one_mul, Units.inv_mul, Units.mul_inv]
  simpa only [mul_sub, mul_one, Units.inv_mul, neg_sub] using
    (hcomm.isNilpotent_mul_left u.property).neg

/-- Inversion of a unit corresponds to negation of its logarithm. -/
@[simp] theorem log_inv (u : {u : Rˣ // IsNilpotent ((u : R) - 1)}) :
    log ⟨u.val⁻¹, isNilpotent_inv_sub_one u⟩ = -log u := by
  apply (IsNilpotent.expUnit_eq_expUnit_iff
    (isNilpotent_log ⟨u.val⁻¹, isNilpotent_inv_sub_one u⟩) (isNilpotent_log u).neg).mp
  rw [IsNilpotent.expUnit_log, IsNilpotent.expUnit_neg (isNilpotent_log u),
    IsNilpotent.expUnit_log]

private theorem commute_log (u v : {u : Rˣ // IsNilpotent ((u : R) - 1)})
    (huv : Commute u.val v.val) : Commute (log u) (log v) := by
  obtain ⟨M, hM⟩ := u.property
  obtain ⟨N, hN⟩ := v.property
  have hxy : Commute ((u.val : R) - 1) ((v.val : R) - 1) :=
    (huv.units_val.sub_left (Commute.one_left _)).sub_right (Commute.one_right _)
  rw [log_eq_sum u M hM, log_eq_sum v N hN]
  refine Commute.sum_left _ _ _ ?_
  intro i _
  refine Commute.sum_right _ _ _ ?_
  intro j _
  simp only [Algebra.smul_def]
  exact (Algebra.commute_algebraMap_left _ _).mul_left
    ((Algebra.commute_algebraMap_right _ _).mul_right (hxy.pow_pow i j))

omit ratR in
/-- A product of commuting units with nilpotent coordinates again has nilpotent coordinate. -/
theorem isNilpotent_mul_sub_one (u v : {u : Rˣ // IsNilpotent ((u : R) - 1)})
    (huv : Commute u.val v.val) :
    IsNilpotent ((((u.val * v.val) : Rˣ) : R) - 1) := by
  have hu := (huv.units_val.sub_right (Commute.one_right _))
  have hxy := hu.sub_left (Commute.one_left _)
  have hxu : Commute ((u.val : R) - 1) (u.val : R) :=
    (Commute.refl (u.val : R)).sub_left (Commute.one_left _)
  have hnil := (hxu.mul_right hxy).isNilpotent_add u.property
    (hu.isNilpotent_mul_left v.property)
  have heq : ((u.val : R) - 1) + (u.val : R) * ((v.val : R) - 1) =
      (u.val : R) * (v.val : R) - 1 := by
    rw [mul_sub, mul_one, add_comm, sub_add_sub_cancel]
  simpa only [heq, Units.val_mul] using hnil

/-- The logarithm takes a commuting product to a sum. -/
theorem log_mul (u v : {u : Rˣ // IsNilpotent ((u : R) - 1)})
    (huv : Commute u.val v.val) :
    log ⟨u.val * v.val, isNilpotent_mul_sub_one u v huv⟩ = log u + log v := by
  have hlog := commute_log u v huv
  apply (IsNilpotent.expUnit_eq_expUnit_iff (isNilpotent_log _)
    (hlog.isNilpotent_add (isNilpotent_log u) (isNilpotent_log v))).mp
  rw [IsNilpotent.expUnit_log,
    IsNilpotent.expUnit_add_of_commute (isNilpotent_log u) (isNilpotent_log v) hlog,
    IsNilpotent.expUnit_log, IsNilpotent.expUnit_log]

omit ratR in
/-- Integer powers of a unit with nilpotent coordinate still have nilpotent coordinate. -/
theorem isNilpotent_zpow_sub_one (u : {u : Rˣ // IsNilpotent ((u : R) - 1)}) (n : ℤ) :
    IsNilpotent (((u.val ^ n : Rˣ) : R) - 1) := by
  have hnat (m : ℕ) : IsNilpotent (((u.val ^ m : Rˣ) : R) - 1) := by
    induction m with
    | zero => simp
    | succ m hm =>
      simpa only [_root_.pow_succ] using
        isNilpotent_mul_sub_one ⟨u.val ^ m, hm⟩ u ((Commute.refl u.val).pow_left m)
  cases n with
  | ofNat m =>
    change IsNilpotent (((u.val ^ (m : ℤ) : Rˣ) : R) - 1)
    rw [_root_.zpow_natCast]
    exact hnat m
  | negSucc m =>
    simpa only [_root_.zpow_negSucc] using
      isNilpotent_inv_sub_one ⟨u.val ^ (m + 1), hnat (m + 1)⟩

/-- Integer powers correspond to integer multiples of the logarithm. -/
theorem log_zpow (u : {u : Rˣ // IsNilpotent ((u : R) - 1)}) (n : ℤ) :
    log ⟨u.val ^ n, isNilpotent_zpow_sub_one u n⟩ = n • log u := by
  apply (IsNilpotent.expUnit_eq_expUnit_iff (isNilpotent_log _)
    ((isNilpotent_log u).smul n)).mp
  rw [IsNilpotent.expUnit_log, IsNilpotent.expUnit_zsmul (isNilpotent_log u) n,
    IsNilpotent.expUnit_log]

omit ratR in
/-- Conjugation preserves the nilpotence of the coordinate at one. -/
theorem isNilpotent_conj_sub_one (u : {u : Rˣ // IsNilpotent ((u : R) - 1)}) (a : Rˣ) :
    IsNilpotent ((((a * u.val * a⁻¹) : Rˣ) : R) - 1) := by
  simpa only [Units.val_mul, mul_sub, sub_mul, mul_one, Units.mul_inv] using
    u.property.units_conj a

/-- The logarithm commutes with conjugation by arbitrary units. -/
theorem log_conj (u : {u : Rˣ // IsNilpotent ((u : R) - 1)}) (a : Rˣ) :
    log ⟨a * u.val * a⁻¹, isNilpotent_conj_sub_one u a⟩ =
      (a : R) * log u * (↑a⁻¹ : R) := by
  apply (IsNilpotent.expUnit_eq_expUnit_iff
    (isNilpotent_log ⟨a * u.val * a⁻¹, isNilpotent_conj_sub_one u a⟩)
    ((isNilpotent_log u).units_conj a)).mp
  rw [IsNilpotent.expUnit_log, IsNilpotent.expUnit_conj (isNilpotent_log u) a,
    IsNilpotent.expUnit_log]

omit ratR [Algebra ℚ S] in
/-- Mapping a unit by a ring homomorphism preserves its nilpotent coordinate. -/
theorem isNilpotent_map_sub_one {F : Type*} [FunLike F R S] [RingHomClass F R S] (f : F)
    (u : {u : Rˣ // IsNilpotent ((u : R) - 1)}) :
    IsNilpotent (((Units.map (f : R →+* S).toMonoidHom u.val : Sˣ) : S) - 1) := by
  change IsNilpotent (f (u.val : R) - 1)
  simpa only [map_sub, map_one] using u.property.map f

/-- The logarithm is natural for rational algebra homomorphisms. -/
theorem log_map (f : R →ₐ[ℚ] S) (u : {u : Rˣ // IsNilpotent ((u : R) - 1)}) :
    log ⟨Units.map f.toMonoidHom u.val, isNilpotent_map_sub_one f u⟩ = f (log u) := by
  apply (IsNilpotent.expUnit_eq_expUnit_iff
    (isNilpotent_log ⟨Units.map f.toMonoidHom u.val, isNilpotent_map_sub_one f u⟩)
    ((isNilpotent_log u).map f)).mp
  rw [IsNilpotent.expUnit_log]
  apply Units.ext
  simpa using (isNilpotent_log u).map_exp (f : R →+* S)

include ratR in
/-- A unit with nilpotent coordinate and positive finite order is one.
This does not assert torsion-freeness of the whole unit group. -/
theorem eq_one_of_unipotent_pow_eq_one (u : {u : Rˣ // IsNilpotent ((u : R) - 1)})
    (n : ℕ) (hn : 0 < n) (hpow : u.val ^ n = 1) : u.val = 1 := by
  have hz : (n : ℤ) • log u = 0 := by
    rw [← log_zpow u (n : ℤ)]
    simpa only [zpow_natCast, hpow] using (log_one (R := R))
  have hq : (n : ℚ) • log u = 0 := by
    simpa only [← Int.cast_smul_eq_zsmul ℚ, Int.cast_natCast] using hz
  apply (log_eq_zero_iff u).mp
  exact (smul_eq_zero.mp hq).resolve_left (Nat.cast_ne_zero.mpr (Nat.ne_of_gt hn))

end Units
